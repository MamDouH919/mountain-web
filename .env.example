# Contact form email delivery (https://resend.com). Without a key, leads are
# logged to the server console in development and the form errors in production.
RESEND_API_KEY=
# Optional. Defaults to the agency email in src/content/site.ts.
CONTACT_TO=
# Optional. Must be a sender on a domain verified in Resend.
CONTACT_FROM="Mountain Website <hello@yourdomain.com>"
